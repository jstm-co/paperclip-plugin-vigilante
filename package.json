{
  "name": "paperclip-plugin-vigilante",
  "version": "0.1.0",
  "type": "module",
  "description": "Watches blocked-issue chains in Paperclip and reports the stopper issue nobody moves (watch-only in v1)",
  "homepage": "https://github.com/jstm-co/paperclip-plugin-vigilante#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstm-co/paperclip-plugin-vigilante.git"
  },
  "bugs": {
    "url": "https://github.com/jstm-co/paperclip-plugin-vigilante/issues"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "blocked",
    "watchdog",
    "monitoring"
  ],
  "author": "JSTM",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.824.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
